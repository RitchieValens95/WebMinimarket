@model SistemaVentas.Entidades.HistorialCliente
@using System.Globalization
@using SistemaVentas.Web.Seguridad
@{ ViewBag.Title="Historial de compras";var cultura=CultureInfo.GetCultureInfo("es-PY"); }
<h1 class="h2">Historial de compras</h1>
<p><strong>@Model.Cliente.Nombre</strong></p>
@if(Model.SoloPropias){<div class="alert alert-info">Se muestran únicamente las ventas confirmadas que registraste tú, según tus permisos.</div>}
<p>@Model.Total compra(s) confirmada(s). Importe total visible: <strong>@Model.ImporteTotal.ToString("N2",cultura)</strong>.</p>
<div class="table-responsive bg-white border rounded"><table class="table table-striped align-middle mb-0">
<thead><tr><th scope="col">Venta N.º</th><th scope="col">Fecha (Paraguay)</th><th scope="col">Vendedor</th><th scope="col">Total</th></tr></thead><tbody>
@foreach(var compra in Model.Compras){
<tr><td>@compra.Numero</td><td>@HoraParaguay.Mostrar(compra.Fecha)</td><td>@compra.Vendedor</td><td>@compra.Total.ToString("N2",cultura)</td></tr>
}
@if(Model.Compras.Count==0){<tr><td colspan="4" class="text-center py-4">No hay compras confirmadas visibles para este cliente.</td></tr>}
</tbody></table></div>
<nav class="d-flex align-items-center gap-3 my-3" aria-label="Paginación de compras del cliente">
@if(Model.Pagina>1){<a href="@Url.Action("Historial",new{id=Model.Cliente.Id,pagina=Model.Pagina-1})">Anterior</a>}
<span>Página @Model.Pagina de @Math.Max(1,(Model.Total+19)/20)</span>
@if((long)Model.Pagina*20<Model.Total){<a href="@Url.Action("Historial",new{id=Model.Cliente.Id,pagina=Model.Pagina+1})">Siguiente</a>}
</nav>
<a class="btn btn-outline-secondary" href="@Url.Action("Detalle",new{id=Model.Cliente.Id})">Volver al cliente</a>
