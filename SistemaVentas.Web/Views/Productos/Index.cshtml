@model SistemaVentas.Web.ViewModels.ProductosListado
@using SistemaVentas.Web.Seguridad
@using System.Globalization
@{
    ViewBag.Title="Productos";
    var f=Model.Datos.Filtro;
    var puedeEditar=SeguridadWeb.Usuario(Context).Puede("PRODUCTOS_EDITAR");
    var cultura=CultureInfo.GetCultureInfo("es-PY");
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
<h1 class="h2">Productos</h1>
@if(puedeEditar) { <a class="btn btn-primary" href="@Url.Action("Crear")">Nuevo producto</a> }
</div>
@using(Html.BeginForm("Index","Productos",FormMethod.Get,new{@class="row g-2 mb-3"})) {
<div class="col-lg-6"><label for="Busqueda" class="form-label">Descripción, código interno o código de barras</label>
<input id="Busqueda" name="Busqueda" class="form-control" value="@f.Busqueda" maxlength="200" autofocus="autofocus" placeholder="Escanea un código y presiona Enter" /></div>
<div class="col-lg-3"><label for="CategoriaId" class="form-label">Categoría</label>
@Html.DropDownList("CategoriaId",new SelectList(Model.Opciones.Categorias,"Id","Nombre",f.CategoriaId),"Todas",new{@class="form-select"})</div>
<div class="col-lg-3"><label for="MarcaId" class="form-label">Marca</label>
@Html.DropDownList("MarcaId",new SelectList(Model.Opciones.Marcas,"Id","Nombre",f.MarcaId),"Todas",new{@class="form-select"})</div>
<div class="col-md-4"><label for="Estado" class="form-label">Estado</label>
@Html.DropDownList("Estado",new SelectList(new[]{new{Valor="todos",Texto="Todos"},new{Valor="activos",Texto="Activos"},new{Valor="inactivos",Texto="Inactivos"}},"Valor","Texto",f.Estado),new{@class="form-select"})</div>
<div class="col-md-4"><label for="Stock" class="form-label">Existencias</label>
@Html.DropDownList("Stock",new SelectList(new[]{new{Valor="todos",Texto="Todas"},new{Valor="bajo",Texto="Stock bajo o agotado"},new{Valor="agotado",Texto="Agotado"}},"Valor","Texto",f.Stock),new{@class="form-select"})</div>
<div class="col-md-4 d-flex align-items-end gap-2"><button type="submit" class="btn btn-outline-primary">Buscar</button><a class="btn btn-outline-secondary" href="@Url.Action("Index")">Limpiar</a></div>
}
<p>@Model.Datos.Total producto(s) encontrado(s).</p>
<div class="table-responsive bg-white border rounded"><table class="table table-hover align-middle mb-0">
<thead><tr><th scope="col">Código</th><th scope="col">Descripción</th><th scope="col">Categoría / marca</th><th scope="col">Precio de venta</th><th scope="col">Existencias</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead><tbody>
@foreach(var p in Model.Datos.Registros) {
<tr><td>@p.Codigo</td><td>@p.Descripcion</td><td>@p.Categoria<br /><span class="text-muted">@(string.IsNullOrEmpty(p.Marca)?"Sin marca":p.Marca)</span></td>
<td>@p.PrecioVenta.ToString("N2",cultura)</td><td>@p.StockActual.ToString(p.PermiteDecimales?"N3":"N0",cultura) @p.UnidadMedida
@if(p.StockActual<=p.StockMinimo) { <span class="badge bg-warning text-dark">@(p.StockActual==0?"Agotado":"Stock bajo")</span> }</td>
<td>@(p.Activo?"Activo":"Inactivo")</td><td>
<a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Detalle",new{id=p.Id})">Ver</a>
@if(puedeEditar) {
<a class="btn btn-sm btn-outline-primary" href="@Url.Action("Editar",new{id=p.Id})">Editar</a>
if(p.Activo) {
using(Html.BeginForm("Desactivar","Productos",FormMethod.Post,new{@class="d-inline",onsubmit="return confirm('¿Desactivar este producto? Sus existencias e historial se conservarán.');"})) {
@Html.AntiForgeryToken()
<input type="hidden" name="id" value="@p.Id" /><input type="hidden" name="version" value="@p.Version" />
<button class="btn btn-sm btn-outline-danger" type="submit">Desactivar</button>
}
}
}
</td></tr>
}
@if(Model.Datos.Registros.Count==0) { <tr><td colspan="7" class="text-center py-4">No hay productos para esta búsqueda.</td></tr> }
</tbody></table></div>
<nav class="d-flex align-items-center gap-3 mt-3" aria-label="Paginación de productos">
@if(f.Pagina>1) { <a href="@Url.Action("Index",new{Pagina=f.Pagina-1,f.Busqueda,f.Estado,f.CategoriaId,f.MarcaId,f.Stock})">Anterior</a> }
<span>Página @f.Pagina de @Math.Max(1,(Model.Datos.Total+19)/20)</span>
@if((long)f.Pagina*20<Model.Datos.Total) { <a href="@Url.Action("Index",new{Pagina=f.Pagina+1,f.Busqueda,f.Estado,f.CategoriaId,f.MarcaId,f.Stock})">Siguiente</a> }
</nav>
